# Required for ingest, resume extraction, chat, matching, and resume tailoring.
OPENAI_API_KEY=
# Optional OpenAI-compatible endpoint and explicit model overrides.
# OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EXTRACTION_MODEL=gpt-4.1-mini
CHAT_MODEL=gpt-4.1

# Compose selects the localhost origin from this port.
# WEB_PORT=38080
# WEB_ORIGIN=http://localhost:38080
COOKIE_SECURE=false

# Optional measurement. No prompts, outputs or account IDs are sent to Langfuse.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
